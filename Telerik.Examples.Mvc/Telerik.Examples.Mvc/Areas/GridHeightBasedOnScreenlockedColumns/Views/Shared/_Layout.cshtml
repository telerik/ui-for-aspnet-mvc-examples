<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @{
        var kendoVersion = "2026.3.1015";
        var themeVersion = "14.6.1";
        var themeHref = String.Format("https://cdn.jsdelivr.net/npm/@progress/kendo-theme-default@{0}/dist/all.css", themeVersion);
        var kendoAllSrc = String.Format("https://cdn.jsdelivr.net/npm/@progress/kendo-ui@{0}/umd/kendo.all.min.js", kendoVersion);
        var kendoAspnetmvcSrc = String.Format("https://cdn.jsdelivr.net/npm/@progress/kendo-ui@{0}/umd/kendo.aspnetmvc.min.js", kendoVersion);
    }

    <link href="@themeHref" rel="stylesheet" type="text/css" />
    <link href="https://unpkg.com/%40progress/kendo-font-icons/dist/index.css" rel="stylesheet" type="text/css" />


    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="@kendoAllSrc"></script>
    <script src="@kendoAspnetmvcSrc"></script>
</head>
<body>
    @RenderBody()
</body>
</html>