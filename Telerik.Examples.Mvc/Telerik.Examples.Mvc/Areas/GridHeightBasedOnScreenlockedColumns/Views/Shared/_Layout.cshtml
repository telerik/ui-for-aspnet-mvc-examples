    <script src="https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@@@kendoVersion/umd/kendo.aspnetmvc.min.js" integrity="sha256-lrBA/9nfQjjsWsEg/ll9spSpccZmq7rpoxSnmpJdO+w=" crossorigin="anonymous"></script>
