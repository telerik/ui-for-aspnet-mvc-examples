<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' http://localhost:62242/; img-src 'self' data:; script-src 'self' https://cdn.jsdelivr.net https://code.jquery.com/ 'nonce-Telerik-CSP-Examples'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data:;connect-src 'self' wss://localhost;" />
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @{
        var kendoVersion = "2024.2.514";
        var themeVersion = "8.0.1";
    }

    <link href="https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-default@@@themeVersion/dist/all.css" integrity="sha256-wKb7X906MramyzxzSdhx7inevPcnEaC2ZIasIg3nnwY=" crossorigin="anonymous" rel="stylesheet" type="text/css" />

    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/Scripts/bootstrap.min.js")"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"
            integrity="sha256-2Pmvv0kuTBOenSvLm6bvfBSSHrUJ+3A7x6P5Ebd07/g="
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@@@kendoVersion/umd/kendo.all.min.js" integrity="sha256-IXsN3dTg0X4feeQgMcjsjxyKAi+ysqKKGhkMNFYSnOw=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@@@kendoVersion/umd/kendo.aspnetmvc.min.js" integrity="sha256-lrBA/9nfQjjsWsEg/ll9spSpccZmq7rpoxSnmpJdO+w=" crossorigin="anonymous"></script>
</head>
<body>
    <div id="responsive-panel" class="navbar navbar-dark bg-light">
        @(Html.Kendo().Menu()
            .Name("Menu")
            .HtmlAttributes(new { style="width:100%" })
            .Orientation(MenuOrientation.Vertical)
            .Items(items =>
            {
                items.Add().Text("Grid CSP Compatibility Overview Demo").Action("Demo_Overview_CSP", "Demo_Overview_CSP");
                items.Add().Text("Grid CSP Compatibility DetailTemplate Demo Example").Action("Demo_Detail_Template_CSP", "Demo_Detail_Template_CSP");
            })
            .Deferred()
        )
    </div>

    <div class="container body-content">
        <div id="responsive-panel" class="navbar navbar-dark bg-light">
 
        </div>
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>