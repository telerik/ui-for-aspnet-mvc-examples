<script>
    var stylesheet = document.querySelector("#kendo-theme");
    //retrieve the theme url from the localStorage:
    var theme = localStorage.getItem('theme');
    var themeIntegrityByUrl = {
        "https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-default@8.2.1/dist/default-main.css": "sha256-QZTDNQ1IW640uEy/n46E8CqW22HgLPRfQBNkpZ1r9Ho=",
        "https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-bootstrap@6.4.0/dist/all.css": "sha256-XrVJxJbHLyDk/Om1Mbk5D03SRRuUYlw2KVGdi3UF+Zg="
    };
    if (theme && themeIntegrityByUrl[theme] && theme !== stylesheet.getAttribute('href')) {
        //pass the url to the stylesheet's href attribute
        stylesheet.setAttribute('href', theme);
        stylesheet.setAttribute('integrity', themeIntegrityByUrl[theme]);
        stylesheet.setAttribute('crossorigin', 'anonymous');
    } else if (theme && !themeIntegrityByUrl[theme]) {
        localStorage.removeItem('theme');
    }
</script>

<div class="configurator">
    <h4>Select Theme:</h4>
    <button id="load-default">Default Theme</button>
    <button id="load-bootstrap">Bootstrap Theme</button>
</div>

<div>
    <h4>Basic Button</h4>
    <p>
        @(Html.Kendo().Button()
        .Name("primaryTextButton")
        .ThemeColor(ThemeColor.Primary)
        .Content("Primary Button"))
        @(Html.Kendo().Button()
        .Name("textButton")
        .HtmlAttributes( new {type = "button"} )
        .Content("Button"))
    </p>
</div>

<div style="text-align: center;">
    <h4>Pick a date</h4>
    @(Html.Kendo().Calendar()
            .Name("calendar")
    )
</div>

<script>
    $(document).ready(function () {

        $("#load-default").click(function () {
            var themeUrl = "https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-default@8.2.1/dist/default-main.css";
            $("#kendo-theme").attr({ href: themeUrl, integrity: themeIntegrityByUrl[themeUrl], crossorigin: "anonymous" });
            //save the theme url in localStorage
            localStorage.setItem('theme', themeUrl);
            //reload the whole page:
            location.reload();
        });

        $("#load-bootstrap").click(function () {
            var themeUrl = "https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-bootstrap@6.4.0/dist/all.css";
            $("#kendo-theme").attr({ href: themeUrl, integrity: themeIntegrityByUrl[themeUrl], crossorigin: "anonymous" });
            //save the theme url in localStorage
            localStorage.setItem('theme', themeUrl);
            //reload the whole page:
            location.reload();
        });

        // In order for the whole page to be styled, the <body> element has a 'k-content' class
        $(document.body).addClass("k-content");
    });
</script>