@{
    ViewBag.Title = "Home Page";
    Layout = null;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-default@14.6.1/dist/all.css"  />
<script src="https://cdn.jsdelivr.net/npm/requirejs@2.3.7/require.js" integrity="sha256-ghW5AAC1cb0kHShRLIP1mFXOzDFY25S3my2XTJkjtdI=" crossorigin="anonymous"></script>

    <div class="featured">
        <div class="content-wrapper">
            <hgroup class="title">
                <h1>@ViewBag.Title.</h1>
                <h2>@ViewBag.Message</h2>
            </hgroup>
        </div>
    </div>

@(Html.Kendo().Grid<Telerik.Examples.Mvc.Areas.RequireJS.Models.Product>()
    .Name("grid")
    .DataSource(dataSource => dataSource.Ajax().Read("Read", "Home"))
    .Deferred()
)

<script>
    require.config({
                baseUrl: "https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@2026.3.1015/umd/",
        paths: {
          "jquery": "https://code.jquery.com/jquery-1.9.1.min",
          "jszip": "https://unpkg.com/jszip@3.10.1/dist/jszip.min",
                    "kendo.grid.min": "kendo.all.min",
                    "kendo.aspnetmvc.min": "kendo.aspnetmvc.min",
                }
      });

    require(["jquery", "jszip", "kendo.grid.min", "kendo.aspnetmvc.min" ], initApp);

    function initApp($, JSZip, kendo) {
        window.JSZip = JSZip;

        @Html.Kendo().DeferredScripts(false)
    }
</script>