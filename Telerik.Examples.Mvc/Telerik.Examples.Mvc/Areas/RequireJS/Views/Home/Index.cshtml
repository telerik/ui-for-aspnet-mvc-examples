@{
    ViewBag.Title = "Home Page";
    Layout = null;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-default@8.0.1/dist/all.css" integrity="sha256-wKb7X906MramyzxzSdhx7inevPcnEaC2ZIasIg3nnwY=" crossorigin="anonymous" />
<script src="https://cdn.jsdelivr.net/npm/requirejs@2.3.7/require.js" integrity="sha256-ghW5AAC1cb0kHShRLIP1mFXOzDFY25S3my2XTJkjtdI=" crossorigin="anonymous"></script>

    <div class="featured">
        <div class="content-wrapper">
            <hgroup class="title">
                <h1>@ViewBag.Title.</h1>
                <h2>@ViewBag.Message</h2>
            </hgroup>
        </div>
    </div>

@(Html.Kendo().Grid<Telerik.Examples.Mvc.Areas.RequireJS.Models.Product>()
    .Name("grid")
    .DataSource(dataSource => dataSource.Ajax().Read("Read", "Home"))
    .Deferred()
)

<script>
    require.config({
                baseUrl: "https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@2024.2.514/umd/",
        paths: {
          "jquery": "https://code.jquery.com/jquery-1.9.1.min",
          "jszip": "https://unpkg.com/jszip@3.10.1/dist/jszip.min",
                    "kendo.grid.min": "kendo.all.min",
                    "kendo.aspnetmvc.min": "kendo.aspnetmvc.min",
                },
                onNodeCreated: function (node, config, moduleName) {
                        if (moduleName === "kendo.grid.min") {
                                node.integrity = "sha256-IXsN3dTg0X4feeQgMcjsjxyKAi+ysqKKGhkMNFYSnOw=";
                                node.crossOrigin = "anonymous";
                        }
                        if (moduleName === "kendo.aspnetmvc.min") {
                                node.integrity = "sha256-lrBA/9nfQjjsWsEg/ll9spSpccZmq7rpoxSnmpJdO+w=";
                                node.crossOrigin = "anonymous";
                        }
                }
      });

    require(["jquery", "jszip", "kendo.grid.min", "kendo.aspnetmvc.min" ], initApp);

    function initApp($, JSZip, kendo) {
        window.JSZip = JSZip;

        @Html.Kendo().DeferredScripts(false)
    }
</script>